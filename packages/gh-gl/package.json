{
  "name": "@nicklemmon/gh-gl",
  "version": "0.0.0",
  "description": "Sync a GitHub repo's default branch into a downstream GitLab repo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklemmon/utils.git",
    "directory": "packages/gh-gl"
  },
  "bin": {
    "gh-gl": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".env.schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "varlock": "^1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "*",
    "@repo/anti-slop": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^26.4.0",
    "publint": "*",
    "tsdown": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
