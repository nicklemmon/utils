# @defaultRequired=infer
# ---

# GitHub credential for HTTPS auth. Required only when --github-url is an
# https:// remote; an SSH remote authenticates via the ambient SSH agent and
# needs no token at all.
# @sensitive @optional
GITHUB_TOKEN=

# GitLab credential for HTTPS auth. Required only when --gitlab-url is an
# https:// remote; an SSH remote authenticates via the ambient SSH agent and
# needs no token at all.
# @sensitive @optional
GITLAB_TOKEN=
