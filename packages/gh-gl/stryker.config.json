{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/test-support/**/*.ts"],
  "reporters": ["progress", "html", "json"],
  "htmlReporter": {
    "fileName": "../../reports/stryker/ci/gh-gl.html"
  },
  "jsonReporter": {
    "fileName": "../../reports/stryker/ci/gh-gl.json"
  },
  "tempDirName": "../../reports/stryker/tmp/gh-gl",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 63.85
  }
}
