{
  "name": "@nicklemmon/example",
  "version": "0.0.0",
  "description": "Seed package that exercises the utils monorepo toolchain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklemmon/utils.git",
    "directory": "packages/example"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "*",
    "@repo/typescript-config": "*",
    "publint": "*",
    "tsdown": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
