{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts"],
  "reporters": ["progress", "html", "json"],
  "htmlReporter": {
    "fileName": "../../reports/stryker/ci/dependency-changesets.html"
  },
  "jsonReporter": {
    "fileName": "../../reports/stryker/ci/dependency-changesets.json"
  },
  "tempDirName": "../../reports/stryker/tmp/dependency-changesets",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 69.48
  }
}
